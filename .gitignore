# Environment
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Node / frontend
node_modules/
dist/
build/
.vite/

# AI / ML artifacts (usually too large for Git)
ai/models/*.pkl
ai/models/*.joblib
ai/models/*.pt
ai/models/*.h5
ai/datasets/*.csv
ai/datasets/*.parquet

# Docker
*.log

# Data (don't commit generated datasets or real instrument data)
data/generator/output/
backend/storage/raw/
backend/storage/instruments/
*.db

# IDE
.vscode/
.idea/
.DS_Store

# Docs exports
*.aasx
# Local experiment runs (curated reports may be committed under experiments/results)
experiments/runs/

# Reglas locales de agentes (no versionar)
AGENTS.md
CLAUDE.md
opencode.json
.opencode/

# Material de construccion y evidencias locales de diagramas
.archify/
docs/architecture/*.finalize.json
docs/architecture/*.finalize-summary.json
docs/architecture/*.delivery.json
docs/architecture/*.browser-check.json

# Fichas de fabricante: material de demo, no se redistribuye
experiments/fixtures/datasheets/*.pdf
