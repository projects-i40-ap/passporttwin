# ==============================================================================
# PassportTwin - Environment Configuration Template (.env.example)
# Copy this file to .env and configure specific environment secrets.
# ==============================================================================

# --- DATABASE (PostgreSQL / Canonical Model) ---
POSTGRES_DB=passporttwin
POSTGRES_USER=passporttwin
POSTGRES_PASSWORD=devpassword
POSTGRES_HOST_PORT=5433
# Internal connection URL for services inside the Docker bridge network
DATABASE_URL=postgresql://passporttwin:devpassword@postgres:5432/passporttwin

# --- BACKEND (FastAPI Core Domain) ---
BACKEND_PORT=8000
ENVIRONMENT=development
SECRET_KEY=changeme-generate-a-real-secret-for-anything-beyond-local-dev

# --- INTEROPERABILITY (Eclipse BaSyx AAS Server) ---
BASYX_HOST_PORT=4001
BASYX_AAS_URL=http://basyx-aas:4001/aasServer

# --- FRONTEND (Vite / React UI) ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- DATABASE ADMINISTRATION (pgAdmin 4) ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@passporttwin.dev
PGADMIN_DEFAULT_PASSWORD=admin

# --- BI & MONITORING (Metabase) ---
METABASE_PORT=3003
# Health Score: pesos heurísticos finitos entre 0 y 1; deben sumar 1.
# Recrear el backend para aplicar cambios. Véase docs/architecture/health-score.md.
HEALTH_SCORE_WEIGHTS='{"risk_90_days":0.40,"current_error":0.35,"out_of_tolerance":0.25}'
